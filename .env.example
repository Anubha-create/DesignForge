# Server Configuration
PORT=4000
NODE_ENV=development

# Database (SQLite with Prisma)
DATABASE_URL="file:./dev.db"

# AI Evaluation Engine
# Set to 'true' to use the zero-dependency deterministic/heuristic DemoEvaluator.
# Set to 'false' if providing a valid OPENAI_API_KEY.
DEMO_MODE=true
OPENAI_API_KEY=

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SESSION_SECRET=designforge-development-session-secret-at-least-32-chars-long
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Client Configuration
VITE_API_BASE_URL=http://localhost:4000/api
